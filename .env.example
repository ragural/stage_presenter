# ---------------------------------------------------------------- server
HOST=127.0.0.1          # use 0.0.0.0 to share on your LAN
PORT=8000
PRELOAD_MODELS=1        # compile NPU models at startup so the first request is fast

# NOTE: everything below is only the *default*. Use ⚙ Settings in the app to change
#       endpoints at runtime (saved to data/settings.json, which overrides these).

# ---------------------------------------------------------------- LLM (script writing + coaching)
# openvino = local model on Intel NPU/GPU/CPU (default when models/llm/* exists)
# openai   = any OpenAI-compatible endpoint (OpenAI, NVIDIA NIM, OVMS, Ollama, LM Studio...)
# none     = no rewriting, notes are only tidied up
LLM_PROVIDER=openvino          # openvino | anthropic | gemini | openai | none

OV_LLM_DEVICE=NPU                 # NPU | GPU | CPU (falls back automatically)
# OV_LLM_MODEL_DIR=models/llm/Qwen3-8B-int4-cw-ov
OV_NPU_MAX_PROMPT_LEN=3072
OV_NPU_MIN_RESPONSE_LEN=768

# Used only when LLM_PROVIDER=openai
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=700

# ---------------------------------------------------------------- Whisper (rehearsal feedback)
OV_WHISPER_DEVICE=GPU             # GPU (keeps filler words, ~2s/take) | NPU (fastest, but drops fillers) | CPU
# OV_WHISPER_MODEL_DIR=models/whisper/whisper-small.en-int8-ov
# STT_PROVIDER=openvino          # openvino | openai | none
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

MAX_UPLOAD_MB=200

# ---------------------------------------------------------------- Claude / Gemini (cloud)
# Keys can also be pasted in ⚙ Settings. Blank there = these env vars are used.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
# Claude through Amazon Bedrock instead of an Anthropic API key (also selectable in ⚙ Settings)
# CLAUDE_ACCESS=bedrock           # anthropic | bedrock (default: bedrock when only AWS_BEARER_TOKEN_BEDROCK is set)
# AWS_REGION=us-east-2            # or BEDROCK_REGION to override just for this app
# AWS_BEARER_TOKEN_BEDROCK=       # Bedrock API key; omit to use your AWS credential chain (profile / SSO / role)
# BEDROCK_API=runtime             # runtime (InvokeModel, ids like us.anthropic.claude-opus-5-5) | mantle (anthropic.claude-opus-5-5)
# BEDROCK_MODEL=us.anthropic.claude-opus-5-5
# Claude Code's variables are understood too: CLAUDE_CODE_USE_BEDROCK=1 selects Bedrock, and
# ANTHROPIC_DEFAULT_MODEL / ANTHROPIC_DEFAULT_OPUS_MODEL give the default model when BEDROCK_MODEL is unset.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_STT_MODEL=gemini-2.5-flash
# STT_PROVIDER=gemini             # Claude cannot be a speech provider (no audio input)
